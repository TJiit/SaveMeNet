nlp = spacy.load("en_core_web_sm")
PII_ENTITY_TYPES = ["PERSON", "GPE", "ORG", "DATE", "NORP", "EMAIL", "PHONE"]

def detect_pii(text):
    pii = []
    doc = nlp(text)
    for ent in doc.ents:
        if ent.label_ in PII_ENTITY_TYPES:
            pii.append({
                "id": str(uuid.uuid4()),
                "start": ent.start_char,
                "end": ent.end_char,
                "type": ent.label_,
                "original": ent.text,
                "value": ent.text,
                "anonymized": False
            })
    return pii

def anonymize_random(text, pii_list):
    new_text = text
    updated_pii = []
    offset = 0
    for pii in pii_list:
        replacement = generate_random(pii["type"], pii["original"])
        start = pii["start"] + offset
        end = pii["end"] + offset
        new_text = new_text[:start] + replacement + new_text[end:]
        offset += len(replacement) - (end - start)
        updated_pii.append({**pii, "start": start, "end": start + len(replacement),
                            "value": replacement, "anonymized": True})
    return new_text, updated_pii

def anonymize_realistic(text, pii_list):
    new_text = text
