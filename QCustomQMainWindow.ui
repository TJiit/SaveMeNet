   <string notr="true">*{
   border:none;
   background-color: transparent;
   background:  transparent;
   padding:0;
   margin: 0;
   color: #fff;
}
#centralwidget, #homebutton, #mainbodycontent{
 background-image: url(&quot;C:/Users/Thakshila/Desktop/FYP 2025/Exam/New folder/bg 2.PNG&quot;);
 /*background-color:#ADD8E6;*/
}

#header, #mainbody{
   background-color: black;
}
#pushButton{
   border: 1px solid #6082B6;
   border-radius: 19px;
   text-align: center;
}
QPushButton{
   text-align: left;
   padding: 5px 10px;
   border-top-left-radius: 13px;
   border-bottom-left-radius: 13px;
}
#homebutton{
   border-left: 3px solid #6082B6;
   font-weight:bold;
}
#uploadbutton{
   background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #E6F0FF, stop:1 #FFFFFF);
    color: #6082B6;
    border-radius: 15px;
    font-weight: bold;
    font-size: 20px;
    border: 2px solid #ADD8E6;
    text-align: center;
    padding: 10px;
}
#scanbutton, #scanspecificbutton, #randommask, #realisticmask, #uploadnewbutton, #downloadbutton, #restorebutton_2, #editButton, #loginButton{
   background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #E6F0FF, stop:1 #FFFFFF);
    color: #6082B6;
    border-radius: 15px;
    font-weight: bold;
    font-size: 18px;
    border: 2px solid #ADD8E6;
    text-align: center;
    padding: 10px;
}
#box1, #box2, #box3, #box4, #infoBox1, #infoBox2, #userWidget{
   background-color: black;
}
#lineEdit, #lineEdit2, #lineEdit3{
   background-color: #000080;
}
