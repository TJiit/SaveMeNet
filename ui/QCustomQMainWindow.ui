   <string notr="true">*{
   border:none;
   background-color: transparent;
   background:  transparent;
   padding:0;
   margin: 0;
   color: #fff;
}
#centralwidget, #homebutton, #mainbodycontent{
   background-color:#ADD8E6;
}

#header, #mainbody{
   background-color: white;
}
#pushButton{
   border: 1px solid #6082B6;
   border-radius: 19px;
   text-align: center;
}
QPushButton{
   text-align: left;
   padding: 5px 10px;
   border-top-left-radius: 13px;
   border-bottom-left-radius: 13px;
}
#homebutton{
   border-left: 3px solid #6082B6;
   font-weight:bold;
}</string>
